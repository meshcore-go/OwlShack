# meshcore-bot config — IMPORT TEMPLATE
#
# The bot stores its config in meshcore.db; this file is only read once:
# on first run (when the database has no config yet) a config.toml in the
# working directory is imported automatically, or import explicitly with
#   meshcore-bot -config myconfig.toml   (overwrites the stored config)
# After that, manage everything from the web UI (default http://localhost:4432).

# Connection Settings (KISS modem)
connection = "serial:///dev/ttyACM0"
baudRate = 115200

# Radio Settings
freq = 917.375
bw = 62.50
sf = 7
cr = 8
tx = 22

[[companion]]
name = "Ping Bot"
# privateKey = "<64 hex chars>"   # node identity (ed25519 seed); omit to generate one
latitude = 0.0
longitude = 0.0
advertInterval = 86400            # seconds; 0 = never advertise
channels = ["#testing", "Public"]

[[companion.trigger]]
type = "group"
template = "@[{{.Sender}}] HashSize={{.PathHashSize}} Hops={{.Hops}} Paths={{.PathHashes | formatPathBytes}}"
channels = ["#testing"]
match = ["(?i)^test.*", "(?i)^ping.*"]

# MQTT observer (optional) — exactly one node feeds MQTT, selected by `node`.
# [mqtt]
# node = "Ping Bot"
# iataCode = "AKL"
#
# [[mqtt.broker]]
# name = "letsmesh-us"
# enabled = true
# host = "mqtt-us-v1.letsmesh.net"
# port = 443
# transport = "websockets"
# tlsEnabled = true
# authType = "token"
# audience = "mqtt-us-v1.letsmesh.net"
# packetTopic = "meshcore/{IATA}/{PUBLIC_KEY}/packets"
# statusTopic = "meshcore/{IATA}/{PUBLIC_KEY}/status"
